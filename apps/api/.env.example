# Copy to apps/api/.env (never commit .env).
# Neon dev branch (D12) — Dashboard > Connect > "Pooled connection" string:
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Zero-install fallback (D13): run `pnpm --filter api db:local` and use:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"

# HMAC key for session/reset token hashes, 32+ chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-32-chars-min"

PORT=4000
# Web app origin(s), comma-separated (CORS + Origin check; first one is used in emailed links)
APP_URL="http://localhost:5173"
# Comma-separated emails that become admins (approve AI Pro access requests)
ADMIN_EMAILS="nazimalionline@gmail.com"
# Reverse proxies in front of the API (Vercel sets 1 itself, see src/vercel.ts)
TRUST_PROXY=0
LOG_LEVEL=info

# File storage for uploaded resumes: local (dev disk) | memory (tests) | s3 (production).
# Serverless disks are read-only/ephemeral, so production must use s3 (Vercel defaults to it).
STORAGE_DRIVER=local
# Keep it outside apps/api: the dev watcher restarts the API on any write inside that folder.
STORAGE_DIR=../../.storage
# s3 driver (the first four are required when STORAGE_DRIVER=s3):
#   Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto,
#     your bucket + an R2 API token (Object Read & Write) -> access key id / secret.
#   Supabase Storage: S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3,
#     S3_REGION=<your project's region, e.g. eu-central-1>, keys from Storage > S3 Connection.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Email (password reset). Unset/placeholder -> emails are logged to the console.
# RESEND_API_KEY=re_...
# NOTE: the default sender onboarding@resend.dev only delivers to the Resend account owner's own
# email until you verify a domain in Resend and set MAIL_FROM to an address on it.
# MAIL_FROM="AI Job Copilot <onboarding@resend.dev>"

# AI Pro (Phase 8) — keys are server-side only, never in apps/web.
# AI_PROVIDER=auto picks: Claude if ANTHROPIC_API_KEY is real → else the generic OpenAI-compatible
# endpoint if AI_API_KEY is real → else the built-in simulated engine ($0, no calls).
AI_PROVIDER=auto
ANTHROPIC_API_KEY="sk-ant-your-key-here"
# Generic OpenAI-compatible endpoint (free tiers). Pick one:
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1   models llama-3.1-8b-instant / llama-3.3-70b-versatile
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   models gemini-2.5-flash-lite / gemini-2.5-flash
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1   models ending in ":free"
#   Ollama      AI_BASE_URL=http://localhost:11434/v1   AI_API_KEY=ollama   models e.g. llama3.1
# Note: some free tiers may use prompts for training — resume data is sent to them.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY="your-free-tier-key-here"
# Models for the free endpoint (defaults = Groq Llama; Gemini needs gemini-2.5-flash-lite / gemini-2.5-flash)
# AI_MODEL_EXTRACT=
# AI_MODEL_GENERATE=
# Claude models (defaults claude-haiku-4-5 / claude-sonnet-5-5; claude-haiku-5-5 is ~10x cheaper)
# CLAUDE_MODEL_EXTRACT=
# CLAUDE_MODEL_GENERATE=
# Backup mode: with BOTH keys set, Claude answers first and the free endpoint takes over when Claude
# fails, returns an unusable answer or the monthly budget is spent. "off" disables it.
AI_BACKUP=on
# Per-user AI calls per UTC day, and a global monthly token hard stop (input+output, all users).
AI_DAILY_LIMIT=40
AI_MONTHLY_TOKEN_CAP=2000000
